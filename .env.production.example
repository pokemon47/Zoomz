# Copy to .env.production, chmod 600, and fill in private values. Never commit that file.
PUBLIC_URL=https://your-public-host.example
SECRET_KEY=
POSTGRES_PASSWORD=
# Same password as above, percent-encoded if necessary. Never use SQLite in production.
DATABASE_URL=postgresql+psycopg://zoomz:URL_ENCODED_PASSWORD@db:5432/zoomz
# Obtain these exact values from the provisioned Zenith instance. No automatic injection assumed.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Zoomz
SMTP_TIMEOUT=15
# Use none only if Zenith explicitly supplies an isolated plaintext relay.
# Set the exact trusted ingress CIDR after Zenith confirms it. Never trust 0.0.0.0/0.
TRUSTED_PROXY_CIDR=127.0.0.1/32
MAX_UPLOAD_MB=200
UPLOAD_BODY_LIMIT=201m
SPACE_QUOTA_MB=5120
WEB_PORT=8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact HTTPS attachment hosts confirmed from the provider; empty disables remote fetching.
MCP_SOURCE_HOSTS=
MCP_RENDER_PREVIEWS=0
# Same-image nginx endpoint; enable previews only after a sandbox-enabled smoke test.
MCP_RENDER_ORIGIN=http://127.0.0.1:8080
